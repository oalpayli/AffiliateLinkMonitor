// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Monitor {
  id        String   @id @default(cuid())
  userId    String   // Supabase Auth User UUID for multi-tenancy
  url       String
  frequency String   @default("daily") // hourly, daily, weekly
  lastRun   DateTime?
  nextRun   DateTime @default(now())
  isActive  Boolean  @default(true)
  alertEmail String?
  createdAt DateTime @default(now())

  scans     Scan[]

  @@unique([userId, url]) // Prevent duplicate URLs for the SAME user, but allow across users
  @@index([userId]) // Index for faster lookups by user
}

model UserSubscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique // Supabase Auth User UUID
  
  // Dodo Payments fields
  dodoCustomerId         String?   @unique @map(name: "dodo_customer_id")
  dodoSubscriptionId     String?   @unique @map(name: "dodo_subscription_id")
  dodoProductId          String?   @map(name: "dodo_product_id")
  dodoVariantId          String?   @map(name: "dodo_variant_id")
  dodoCurrentPeriodEnd   DateTime? @map(name: "dodo_current_period_end")
  dodoStatus             String?   @map(name: "dodo_status") // active, cancelled, expired, on_hold
  dodoCancelAtPeriodEnd  Boolean   @default(false) @map(name: "dodo_cancel_at_period_end")
  
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Scan {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())
  params    String? // Store optional filter params as JSON string if needed in future
  
  monitorId String?
  monitor   Monitor? @relation(fields: [monitorId], references: [id])

  links     Link[]

  @@index([createdAt])
}

model Link {
  id        String   @id @default(cuid())
  href      String
  status    String   // 'healthy', 'broken', 'error'
  stockStatus String? @default("unknown") // 'in_stock', 'out_of_stock', 'unknown'
  statusCode Int?
  
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([scanId])
}

model ScanUsage {
  id         String   @id @default(cuid())
  identifier String   // IP address or userId
  date       DateTime @default(now()) @db.Date
  count      Int      @default(1)
  
  @@unique([identifier, date])
  @@index([identifier, date])
}

